# Copy this file to .env for local dev, or set these as environment
# variables in your hosting provider's dashboard (e.g. Vercel/Netlify).

# Base URL of the deployed backend's hospital API
VITE_API_URL=http://localhost:4000/api

# Base URL of the deployed backend's MediTrust (medicine verification) API
VITE_MEDITRUST_API_URL=http://localhost:4000/api/meditrust

# Optional: only needed for the AI MediBot chat widget
VITE_GROQ_API_KEY=your_groq_api_key_here
